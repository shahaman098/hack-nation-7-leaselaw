# Copy to .env and fill in keys you have. Never commit .env.
# At least one provider is required for live analysis; two recommended for lane isolation.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default models (override per-run with CLI flags)
HACKFORGE_OPENAI_MODEL=gpt-4o
HACKFORGE_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: force dry-run (no LLM calls)
# HACKFORGE_DRY_RUN=1
