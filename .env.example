# Copy to .env and fill in keys you have. Never commit .env.
# At least one provider is required for live analysis; two recommended for lane isolation.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default models (LiteLLM model ids)
HACKFORGE_OPENAI_MODEL=gpt-4o
HACKFORGE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Prefer LiteLLM routing when collision extra is installed (default: 1)
HACKFORGE_USE_LITELLM=1

# Optional: force dry-run (no LLM calls)
# HACKFORGE_DRY_RUN=1

# Live collision research (optional — offline analyse still works)
# HACKFORGE_LIVE_RESEARCH=1
PRODUCTHUNT_ACCESS_TOKEN=
APIFY_TOKEN=
# APIFY_ACTOR=gabrielaxy/hackathon-winner-repo-extractor

# Langfuse experimental memory (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Embedding / index
HACKFORGE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HACKFORGE_CORPUS_CACHE=corpora/cache
HACKFORGE_INDEX_DIR=corpora/indexes/default
