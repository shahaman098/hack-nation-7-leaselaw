# Copy to .env and fill in keys you have. Never commit .env.
# DeepSeek is the default and requires a real API key. Other providers are explicit opt-ins.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Default models (LiteLLM model ids)
HACKFORGE_OPENAI_MODEL=gpt-4o
HACKFORGE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# DeepSeek V4 Pro is the default when DEEPSEEK_API_KEY is configured.
HACKFORGE_DEEPSEEK_MODEL=deepseek-v4-pro
# adaptive = high for research/audit, max for judging. Broad generation disables
# hidden reasoning by default to keep structured search responsive.
HACKFORGE_DEEPSEEK_REASONING=adaptive
# HACKFORGE_DEEPSEEK_GENERATION_THINKING=1  # opt in to slower generation reasoning
# HACKFORGE_DEEPSEEK_MAX_TOKENS=16384
# HACKFORGE_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Hard per-run budgets (conservative DeepSeek V4 pricing; override intentionally).
HACKFORGE_MAX_LLM_CALLS=40
HACKFORGE_MAX_TOTAL_TOKENS=750000
HACKFORGE_MAX_COST_USD=2.00
# HACKFORGE_DEEPSEEK_INPUT_USD_PER_MILLION=0.435
# HACKFORGE_DEEPSEEK_OUTPUT_USD_PER_MILLION=0.87

# GitHub evidence is required. Devpost live search is attempted, but its public
# endpoint is often WAF-blocked; the downloaded Devpost corpus remains mandatory.
HACKFORGE_MIN_GITHUB_RESULTS=1
HACKFORGE_MIN_DEVPOST_RESULTS=0
HACKFORGE_REQUIRE_LIVE_DEVPOST=0
GITHUB_TOKEN=

# Semantic collision search is mandatory for trusted live runs.
HACKFORGE_REQUIRE_SEMANTIC_COLLISION=1
HACKFORGE_USE_SENTENCE_TRANSFORMERS=1

# Optional explicit Codex execution; by default Codex selects the authenticated
# account's supported model. Set this only for a model your account supports.
# HACKFORGE_CODEX_MODEL=
# HACKFORGE_CODEX_BINARY=/absolute/path/to/codex
# HACKFORGE_CODEX_TIMEOUT=300
# HACKFORGE_CODEX_DOCTOR_TIMEOUT=90
# LiteLLM is only used with explicit --provider litellm.
HACKFORGE_USE_LITELLM=0

# Live collision research (optional — offline analyse still works)
# HACKFORGE_LIVE_RESEARCH=1
PRODUCTHUNT_ACCESS_TOKEN=
APIFY_TOKEN=
# APIFY_ACTOR=gabrielaxy/hackathon-winner-repo-extractor

# Langfuse experimental memory (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Embedding / index
HACKFORGE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave these unset to use HACKFORGE_HOME (or the repository-local defaults).
# HACKFORGE_CORPUS_CACHE=/absolute/path/to/corpus-cache
# HACKFORGE_INDEX_DIR=/absolute/path/to/faiss-index
# HACKFORGE_HACKREP_DIR=/absolute/path/to/hackrep-cache

# Installed releases default to ~/.hackforge. Override state/output locations if needed.
# HACKFORGE_HOME=/absolute/path/to/hackforge-state
# HACKFORGE_RUNS_DIR=/absolute/path/to/runs
