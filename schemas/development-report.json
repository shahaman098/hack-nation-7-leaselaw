{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevelopmentReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "product_root", "checks_executed", "scaffold", "tasks", "gui_smoke", "notes"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "product_root": {"type": "string", "minLength": 1},
    "checks_executed": {"type": "boolean"},
    "scaffold": {
      "type": "object", "additionalProperties": false,
      "required": ["stack", "entry_point"],
      "properties": {
        "stack": {"type": "string", "minLength": 1},
        "entry_point": {"type": "string", "minLength": 1},
        "run_command": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      }
    },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "title", "status", "files_written", "check_command", "check_status", "repair_attempts", "notes"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["implemented", "failed"]},
          "files_written": {"type": "array", "items": {"type": "string"}},
          "check_command": {"type": ["string", "null"]},
          "check_status": {"type": "string", "enum": ["passed", "failed", "not_run"]},
          "repair_attempts": {"type": "integer", "minimum": 0},
          "notes": {"type": "string"}
        }
      }
    },
    "gui_smoke": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["attempted", "ok"],
      "properties": {
        "attempted": {"type": "boolean"},
        "ok": {"type": "boolean"},
        "command": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "http_status": {"type": ["integer", "null"]},
        "notes": {"type": "string"}
      }
    },
    "notes": {"type": "string"}
  }
}
