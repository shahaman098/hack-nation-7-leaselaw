{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackforge.local/schemas/candidate-idea.json",
  "title": "CandidateIdea",
  "type": "object",
  "required": [
    "id",
    "primary_user",
    "painful_workflow",
    "current_workaround",
    "imported_mechanism",
    "data_sources",
    "core_computation",
    "last_mile_action",
    "visible_transformation",
    "killer_demo"
  ],
  "properties": {
    "id": { "type": "string" },
    "lane": { "type": "string" },
    "disciplines": { "type": "array", "items": { "type": "string" } },
    "working_title": { "type": "string" },
    "primary_user": { "type": "string" },
    "painful_workflow": { "type": "string" },
    "current_workaround": { "type": "string" },
    "imported_mechanism": { "type": "string" },
    "mechanism_origin": { "type": "string" },
    "data_sources": { "type": "array", "items": { "type": "string" } },
    "core_computation": { "type": "string" },
    "last_mile_action": { "type": "string" },
    "visible_transformation": { "type": "string" },
    "sponsor_dependency": { "type": "string" },
    "technical_risk": { "type": "string" },
    "collision_risk": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
    "why_now": { "type": "string" },
    "kill_reason": { "type": "string" },
    "killer_demo": { "type": "string" },
    "hard_to_fake_advantage": { "type": "string" },
    "cluster_id": { "type": ["string", "null"] }
  }
}
