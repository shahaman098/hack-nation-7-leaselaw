{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackforge.local/schemas/collision-report.json",
  "title": "CollisionReport",
  "type": "object",
  "required": ["candidate_id", "nearest_analogues", "collision_risk"],
  "properties": {
    "candidate_id": { "type": "string" },
    "nearest_analogues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source", "similarities", "differences"],
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string" },
          "similarities": {
            "type": "object",
            "properties": {
              "same_user": { "type": "boolean" },
              "same_problem": { "type": "boolean" },
              "same_mechanism": { "type": "boolean" },
              "same_data": { "type": "boolean" },
              "same_action": { "type": "boolean" },
              "same_demo": { "type": "boolean" }
            }
          },
          "differences": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "collision_risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "observable_differentiator": { "type": "string" },
    "differentiator_is_substantive": { "type": "boolean" },
    "kill_recommendation": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
