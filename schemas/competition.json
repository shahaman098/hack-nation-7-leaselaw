{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackforge.local/schemas/competition.json",
  "title": "CompetitionBrief",
  "type": "object",
  "required": [
    "name", "slug", "source_urls", "theme", "tracks", "sponsors", "deadline", "team_size",
    "required_or_encouraged_tech", "prizes", "facts", "inference", "missing", "potentially_stale",
    "judging_criteria", "sponsor_capabilities", "available_datasets", "crowding", "sanitized_brief"
  ],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "slug": { "type": "string" },
    "source_urls": { "type": "array", "items": { "type": "string" } },
    "theme": { "type": "string" },
    "tracks": { "type": "array", "items": { "type": "string" } },
    "sponsors": { "type": "array", "items": { "type": "string" } },
    "deadline": { "type": ["string", "null"] },
    "team_size": { "type": ["string", "null"] },
    "required_or_encouraged_tech": { "type": "array", "items": { "type": "string" } },
    "prizes": { "type": "array", "items": { "type": "string" } },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "inference": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "rationale"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "missing": { "type": "array", "items": { "type": "string" } },
    "potentially_stale": { "type": "array", "items": { "type": "string" } },
    "judging_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "weight_or_priority"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "weight_or_priority": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "sponsor_capabilities": { "type": "array", "items": { "type": "string" } },
    "available_datasets": { "type": "array", "items": { "type": "string" } },
    "crowding": {
      "type": "object",
      "required": ["high_collision", "medium_collision", "potentially_underexplored", "do_not_build"],
      "additionalProperties": false,
      "properties": {
        "high_collision": { "type": "array", "items": { "type": "string" } },
        "medium_collision": { "type": "array", "items": { "type": "string" } },
        "potentially_underexplored": { "type": "array", "items": { "type": "string" } },
        "do_not_build": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sanitized_brief": { "type": "string" }
  }
}
