{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifiedHackathonWinner",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_name",
    "competition",
    "year",
    "placement",
    "source_url",
    "primary_user",
    "problem",
    "mechanism",
    "demo_hook",
    "event_date"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "project_name": { "type": "string", "minLength": 1 },
    "competition": { "type": "string", "minLength": 1 },
    "year": { "type": "integer", "minimum": 2005, "maximum": 2100 },
    "placement": { "type": "string", "minLength": 1 },
    "track": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "primary_user": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "mechanism": { "type": "string", "minLength": 1 },
    "demo_hook": { "type": "string", "minLength": 1 },
    "event_date": { "type": "string", "format": "date" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
