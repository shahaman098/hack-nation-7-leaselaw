{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackforge.local/schemas/evidence-source.json",
  "title": "EvidenceSource",
  "type": "object",
  "required": ["id", "url", "source_kind", "retrieved_at", "fetch_status", "verified"],
  "properties": {
    "id": {"type": "string"},
    "url": {"type": "string"},
    "title": {"type": "string"},
    "source_kind": {"enum": ["official", "devpost", "github", "corpus", "web", "input"]},
    "retrieved_at": {"type": "string"},
    "excerpt": {"type": "string"},
    "fetch_status": {"enum": ["ok", "failed", "rate_limited", "blocked"]},
    "http_status": {"type": ["integer", "null"]},
    "error": {"type": "string"},
    "content_hash": {"type": "string"},
    "verified": {"type": "boolean"}
  },
  "additionalProperties": false
}
