{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuildPlan",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"scheduling_status": {"const": "unscheduled"}}},
     "then": {"properties": {"build_window": {"type": "null"}, "tasks": {"items": {"properties": {"time_slot": {"type": "null"}}}}}}},
    {"if": {"properties": {"scheduling_status": {"const": "scheduled"}}},
     "then": {"properties": {"build_window": {"type": "string", "minLength": 1}}}}
  ],
  "required": ["candidate_id", "scheduling_status", "build_window", "summary", "architecture", "tasks", "demo_script", "cut_scope", "submission_checklist", "feasibility_report"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "scheduling_status": {"type": "string", "enum": ["scheduled", "unscheduled"]},
    "build_window": {"type": ["string", "null"]},
    "summary": {"type": "string", "minLength": 1},
    "architecture": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "owner_role", "depends_on", "deliverable", "acceptance_test", "time_slot"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "deliverable": {"type": "string", "minLength": 1},
          "acceptance_test": {"type": "string", "minLength": 1},
          "time_slot": {"type": ["string", "null"]}
        }
      }
    },
    "demo_script": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cut_scope": {"type": "array", "items": {"type": "string"}},
    "submission_checklist": {"type": "array", "items": {"type": "string"}},
    "feasibility_report": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "delivery_risk", "critical_dependencies", "fakeable_parts", "non_fakeable_core", "minimum_demonstrable_loop", "kill_recommendation", "notes"],
      "properties": {
        "candidate_id": {"type": "string"},
        "delivery_risk": {"type": "string", "enum": ["low", "medium", "high"]},
        "critical_dependencies": {"type": "array", "items": {"type": "string"}},
        "fakeable_parts": {"type": "array", "items": {"type": "string"}},
        "non_fakeable_core": {"type": "string"},
        "minimum_demonstrable_loop": {"type": "string"},
        "kill_recommendation": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}
