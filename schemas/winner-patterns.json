{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WinnerPatterns",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "competition",
    "winning_archetypes",
    "mechanism_families",
    "demo_patterns",
    "anti_patterns",
    "track_hints"
  ],
  "properties": {
    "competition": { "type": "string" },
    "winning_archetypes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mechanism_families": {
      "type": "array",
      "items": { "type": "string" }
    },
    "demo_patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "anti_patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "track_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["track", "mechanisms"],
        "properties": {
          "track": { "type": "string" },
          "mechanisms": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "source_winner_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
