{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkMap",
  "type": "object",
  "required": ["workflow_id", "steps", "lessons"],
  "properties": {
    "workflow_id": { "type": "string" },
    "title": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "decision", "reason", "guardrails", "evidence"],
        "properties": {
          "step_id": { "type": "string" },
          "screen_moment": { "type": "string" },
          "decision": { "type": "string" },
          "reason": { "type": "string" },
          "guardrails": { "type": "array", "items": { "type": "string" } },
          "confirmation": {
            "type": "string",
            "enum": ["expert_confirmed", "unresolved", "conflict", "ruled"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim_id", "text", "source_audio", "conditions"],
              "properties": {
                "claim_id": { "type": "string" },
                "text": { "type": "string" },
                "source_audio": { "type": "string" },
                "conditions": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lesson_id", "depends_on_step", "state"],
        "properties": {
          "lesson_id": { "type": "string" },
          "depends_on_step": { "type": "string" },
          "state": {
            "type": "string",
            "enum": ["verification_hold", "released"]
          }
        }
      }
    }
  }
}
